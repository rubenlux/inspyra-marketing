# Inspyra API base URL
INSPYRA_API_URL=http://localhost:3001/api/v1

# Agent tokens — generated by POST /api/v1/auth/service-token
# Each agent gets its own token with limited scope
RESEARCH_AGENT_TOKEN=
OPPORTUNITY_AGENT_TOKEN=
PROPOSAL_AGENT_TOKEN=
MEETING_AGENT_TOKEN=
FOLLOWUP_AGENT_TOKEN=

# MCP Server port
MCP_PORT=4000
