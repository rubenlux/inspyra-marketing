# App
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://inspyra:inspyra_dev_secret@localhost:5433/inspyra_erp?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_secret

# JWT
JWT_SECRET=change_me_in_production_must_be_32_chars_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars_min
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Swagger (disable in production)
SWAGGER_ENABLED=true
