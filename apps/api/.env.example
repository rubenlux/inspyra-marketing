# App
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://inspyra:inspyra_dev_secret@localhost:5433/inspyra_erp?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_secret

# JWT
JWT_SECRET=change_me_in_production_must_be_32_chars_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars_min
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Swagger (disable in production)
SWAGGER_ENABLED=true

# INSPYRA Mail — outreach email sending
# MAIL_API_URL: full send endpoint, e.g. https://api.inspyra.cloud/v1/public/mail/send
# MAIL_API_KEY: API key from INSPYRA Mail dashboard (im_live_...)
# MAIL_API_FROM: sender address visible to prospects
MAIL_API_URL=https://api.inspyra.cloud/v1/public/mail/send
MAIL_API_KEY=
MAIL_API_FROM="Inspyra Servicios" <contacto@inspyra.cloud>

# INSPYRA Mail — webhook receiver (ERP-044B)
# WEBHOOK_SECRET: signing secret from INSPYRA Mail webhook settings (used for HMAC SHA256 verification)
WEBHOOK_SECRET=
